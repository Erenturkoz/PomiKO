# --- Sunucu ---
PORT=4000
# React dev sunucusunun adresi (cookie/CORS için)
CORS_ORIGIN=http://localhost:5173

# --- Veritabanı (PostgreSQL) ---
# Kendi kullanıcı adı / parola / veritabanı adınla değiştir
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/almanca_platform?schema=public"

# --- JWT ---
# Bunları güçlü, rastgele değerlerle değiştir (örn. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- İlk admin (seed ile oluşturulur) ---
SEED_ADMIN_EMAIL="admin@platform.local"
# Seed çalıştırmadan önce en az 12 karakterlik güçlü bir parola belirleyin.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Platform Admin"

# --- Daily.co (ders odası video altyapısı) ---
# https://dashboard.daily.co → Developers → API key
DAILY_API_KEY="buraya-daily-api-anahtarini-koy"
